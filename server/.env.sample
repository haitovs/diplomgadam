# Copy to server/.env for local development.
NODE_ENV=development
PORT=4080

# Matches docker-compose.dev.yml (host port 5433).
DATABASE_URL=postgres://tagam:tagam@localhost:5433/tagam_dev

PUBLIC_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Local writable paths. In the container these default to /data/*.
UPLOAD_DIR=../data/uploads
MAPS_DIR=../data/maps

SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=8
MAX_GALLERY_IMAGES=12
MIN_VENUE_PROOF_IMAGES=2

# First boot creates this admin. Leave the password unset to have a random one
# generated and printed to the log exactly once.
BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars

LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
