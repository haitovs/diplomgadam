# Copy to .env and edit before starting the stack.

# ── Required ─────────────────────────────────────────────────────────────────

# Database password. Generate one, for example: openssl rand -base64 24
POSTGRES_PASSWORD=

# Public URL the site is reached at. Used for cookie security and CORS.
# Must start with https:// for session cookies to carry the Secure flag.
PUBLIC_ORIGIN=https://example.tm

# ── Reverse proxy (only when using the "caddy" profile) ──────────────────────

# Domain Caddy should obtain a certificate for. Point its DNS here first.
SITE_ADDRESS=example.tm

# With Caddy in front, keep the app on localhost only:
#   APP_BIND=127.0.0.1
# Without Caddy, leave it reachable:
APP_BIND=0.0.0.0
APP_PORT=4080

# ── Optional ─────────────────────────────────────────────────────────────────

POSTGRES_USER=gadam
POSTGRES_DB=gadam

# Image tag used by docker compose. The bundle script sets this for you.
APP_IMAGE=gadam-restaurant:latest

# Set when the app sits behind a proxy so client IPs are read from headers.
TRUST_PROXY=true

SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=8
MAX_GALLERY_IMAGES=12
MIN_VENUE_PROOF_IMAGES=2

LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# First boot creates this administrator. Leave the password blank to have a
# random one generated and printed once to the container log.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ── Backups (only when using the "backup" profile) ───────────────────────────

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
